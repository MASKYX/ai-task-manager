# PostgreSQL (required)
POSTGRES_DB=ai_task_manager
POSTGRES_USER=ai_task_manager
POSTGRES_PASSWORD=<generate-a-long-random-password>

# Cognito (required)
COGNITO_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<pool-id>
COGNITO_APP_CLIENT_ID=<cognito-app-client-id>

# Google Calendar OAuth (required)
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://api.tasks.example.com/login/oauth2/code/google
GOOGLE_TOKEN_ENCRYPTION_KEY=<generate-once-with-openssl-rand-base64-32>

# Gemini / internal FastAPI (required)
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash-lite

# Public URLs used by Spring Boot
FRONTEND_ORIGIN=https://tasks.example.com
FRONTEND_URL=https://tasks.example.com/
PUBLIC_BACKEND_URL=https://api.tasks.example.com

# Public value compiled into the frontend image. The other Vite values are
# derived by compose.yaml from the Cognito and public URL settings above.
VITE_COGNITO_DOMAIN=https://<domain>.auth.<region>.amazoncognito.com

# Optional host bindings. Loopback prevents direct Internet exposure.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8081

# Optional application settings
AI_DAILY_REQUEST_LIMIT=20
AI_TIME_ZONE=Europe/Madrid
