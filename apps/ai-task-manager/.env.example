# Copy to .env for local development; never commit real values.
DB_URL=jdbc:postgresql://localhost:5432/ai_task_manager
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>
COGNITO_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<pool-id>
COGNITO_APP_CLIENT_ID=<same value as frontend VITE_COGNITO_CLIENT_ID>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# Generate once with: openssl rand -base64 32; keep the value safe across restarts.
GOOGLE_TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
# Local HTTP only. Leave the secure-cookie default enabled in production.
SESSION_COOKIE_SECURE=false
